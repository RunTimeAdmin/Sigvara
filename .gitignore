# Foundry build artifacts
out/
cache/

# Foundry deployment run records (local history; sensitive values live in the
# already-ignored cache/, never here)
broadcast/

# Dependencies (installed by forge install)
lib/

# SDK
packages/sdk/dist/
packages/sdk/node_modules/

# Oracle
oracle/node_modules/
oracle/.state/

# Environment
.env
.env.*
!.env.example
!.env.checker.example
!.env.watcher.example
!.env.mainnet.example
!.env.mainnet.checker.example
!.env.mainnet.watcher.example

# Compose file secrets: docker-compose.mainnet.yml reads ./secrets/oracle_key.
# A directory pattern, so it does not touch oracle/secrets.js.
secrets/

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Scan output
reports/
.scarpshield/

# Brand assets — uploaded directly to the host, never committed.
# Previous images were scraped from GitHub raw links and used for a scam token.
site/assets/*.png
site/assets/*.jpg
site/assets/*.jpeg
site/assets/*.gif
site/assets/*.webp
# Root-level brand/profile images dropped in for review are never committed either
sigvara-profile-pic.*

# Local zip archives / build scratch, not part of the deployed site
site/*.zip
site/sigvara_v2/

# Wiki generator scratch — pushed directly to the GitHub wiki repo, not tracked here
repowiki/
.qoder/

# Local session artifacts
CODE_REVIEW_REPORT.md

# Local planning spreadsheets (e.g. presale_model.xlsx), not part of the codebase
*.xlsx

# Packaged site builds for hosting uploads (not source)
sigvara-site-*/
sigvara-site-*.zip

# Local probes that assert unfixed vulnerable behaviour. Kept out of the repo
# until the corresponding fixes land.
test/Verify*.t.sol

# Site deployment archive, rebuilt by scripts/package-site.mjs on every deploy
sigvara-site.zip

# Private planning notes. Local only, deliberately not published.
PLANNING-*.md

# Keys, wallets and credentials. Nothing like this should ever be committed. The secret
# scan (scripts/check-secrets.mjs, run in CI and by a local pre-commit hook) is the second
# line of defence; this is the first.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*keystore*.json
UTC--*
wallet*.json
mnemonic*.txt
seed*.txt
private-key*.txt
.npmrc
.netrc

# Runtime state, logs and local overrides
*.log
oracle-state*.json
docker-compose.override.yml
coverage/
*.tgz
/node_modules/

# Root-level scratch: brand images and script output are never committed
/*.png
/*.svg
fat-path-*.json
