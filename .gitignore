# Foundry build artifacts
out/
cache/

# Foundry deployment run records (local history; sensitive values live in the
# already-ignored cache/, never here)
broadcast/

# Dependencies (installed by forge install)
lib/

# SDK
packages/sdk/dist/
packages/sdk/node_modules/

# Oracle
oracle/node_modules/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Scan output
reports/
.scarpshield/

# Brand assets — uploaded directly to the host, never committed.
# Previous images were scraped from GitHub raw links and used for a scam token.
site/assets/*.png
site/assets/*.jpg
site/assets/*.jpeg
site/assets/*.gif
site/assets/*.webp
# Root-level brand/profile images dropped in for review are never committed either
sigvara-profile-pic.*

# Local zip archives / build scratch, not part of the deployed site
site/*.zip
site/sigvara_v2/

# Wiki generator scratch — pushed directly to the GitHub wiki repo, not tracked here
repowiki/
.qoder/

# Local session artifacts
CODE_REVIEW_REPORT.md

# Local planning spreadsheets (e.g. presale_model.xlsx), not part of the codebase
*.xlsx

# Packaged site builds for hosting uploads (not source)
sigvara-site-*/
sigvara-site-*.zip

# Local probes that assert unfixed vulnerable behaviour. Kept out of the repo
# until the corresponding fixes land (see D:\Sigvara-private\security-findings).
test/Verify*.t.sol
