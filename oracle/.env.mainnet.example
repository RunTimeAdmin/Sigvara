# Sigvara oracle, PRIMARY operator, Arc mainnet (chain 5042).
#
# Copy to .env beside docker-compose.mainnet.yml and fill in every line marked FILL.
# The signing key is not in this file. It is a file secret, secrets/oracle_key, mounted
# read-only at /run/secrets/oracle_key (the compose file sets ORACLE_PRIVATE_KEY_FILE).
# Do not add ORACLE_PRIVATE_KEY here: startup refuses a file and a variable together.
#
# The checker and the watcher have their own examples. Do not copy this file to them.

# ---- which role, which code (read by docker compose) -------------------------------
COMPOSE_PROFILES=oracle

# The full 40-character commit hash to build and run. Not a branch or a tag. A deploy is
# a change to this line and `docker compose up -d`; a restart reruns the same image.
SIGVARA_REF=FILL

# The Docker network this container shares with the reverse proxy that terminates TLS,
# and with nothing else. Create it once with `docker network create sigvara-edge`.
EDGE_NETWORK=sigvara-edge

# Loopback port on the host.
HOST_PORT=3030

# ---- chain --------------------------------------------------------------------------
# Measured 21 Oct 2026, mainnet, public endpoint:
#   getLogs span   9,920 blocks answered (quiet address and busy USDC alike)
#   receipts       resolve about 7 days back; blocks and logs resolve further
#   throttling     none at 2 requests a second for 60 calls
# The checker uses a different provider on purpose.
RPC_URL=https://rpc.mainnet.arc.io

# The chain this oracle signs for. Nothing is read for scoring or signed while the RPC
# reports another, and a state file saved on another chain is refused. Needs the oracle code
# from the chain robustness change; older code ignores it.
EXPECTED_CHAIN_ID=5042

# From deployments/5042.json after the mainnet deploy.
IDENTITY_ADDRESS=FILL
REPUTATION_ADDRESS=FILL

# The block the registries were deployed in, minus a small buffer. The agent scan starts
# here on a fresh state file. Scanning from 0 on a busy chain is the quickest way to be
# rate limited into never finishing.
FROM_BLOCK=FILL

# Blocks per eth_getLogs call. Below the measured limit of 9,920 on the two providers
# used for scanning. Do not use dRPC for scanning: it answers about 100.
LOG_CHUNK_SIZE=9000

# ---- transactions and the clock -------------------------------------------------------
# The RPC chooses the fees it quotes, whether a transaction was mined and what time it is.
# These are the defaults, written out. A transaction not mined in TX_WAIT_SECONDS is replaced
# once at twice the fee and the same nonce; one over either ceiling is refused before it is
# signed. The ceilings are loose on purpose (Arc's minimum base fee is 20 gwei, so a normal
# fee is a few dozen): tighten MAX_FEE_GWEI and MAX_TX_COST after a week of real fees.
# The epoch does not run when the chain's latest block time is more than
# MAX_CLOCK_SKEW_SECONDS from this host's clock, so keep the host on NTP (all eight public
# Arc endpoints were within 2 seconds of a synced machine on 22 Oct 2026).
TX_WAIT_SECONDS=60
MAX_FEE_GWEI=1000
MAX_TX_COST=1
MAX_CLOCK_SKEW_SECONDS=600

# ---- cadence ------------------------------------------------------------------------
# Hours between epochs. A proposal waits out the 6 hour challenge window and is finalized
# by whichever operator runs next, and the checker runs hourly, so this does not delay
# finalization.
EPOCH_HOURS=24

# ---- HTTP ---------------------------------------------------------------------------
# Required, because the container binds 0.0.0.0. Startup refuses to run without at least
# one write credential. Generate each with: openssl rand -hex 32
ORACLE_ADMIN_TOKEN=FILL
# One per integration, so revoking one does not mean rotating all. Delete a line and
# `docker compose up -d` to revoke it. Restrict an integration to what it needs: CounterAudit
# records outcomes and nothing else, so a leaked token cannot run an epoch or clear flags.
# ORACLE_TOKEN_COUNTERAUDIT=
# ORACLE_SCOPES_COUNTERAUDIT=attest
ATTEST_COOLDOWN_MS=3600000

# The network the reverse proxy reaches this container from. Without it every visitor is
# keyed on the proxy's address and shares one rate-limit bucket. Use the subnet of the edge
# network:
#   docker network inspect sigvara-edge --format '{{(index .IPAM.Config 0).Subnet}}'
# Needs the oracle code from the HTTP hardening change.
TRUSTED_PROXIES=FILL

# ---- scoring inputs ------------------------------------------------------------------
# These must be identical on the checker. They are not preferences: the checker exists to
# recompute the same score from the same rules, and a different value guarantees a
# divergence on every agent. Defaults are written out so a changed default in a later
# commit cannot move one operator and not the other.
PAYMENT_VERIFICATION=required
# Arc USDC, 6 decimals. A plain native-USDC send emits its Transfer log from a different
# address, at 18 decimals, so it is not counted; only payments made through this ERC-20 are.
PAYMENT_ASSET=0x3600000000000000000000000000000000000000
# Smallest payment that counts, in base units: 10000 is one cent. Keep it above zero.
# Raising it raises the cost of a counterparty that is not real.
PAYMENT_MIN_AMOUNT=10000
PAYMENT_MIN_CONFIRMATIONS=1
# One point of feeScore per $100 of settled volume, capped at 20 points. Not calibrated
# against real mainnet volume yet.
PAYMENT_FEE_UNIT=100000000
PAYMENT_HALF_LIFE_DAYS=90
PAYMENT_MAX_PER_PAYER=4
PAYMENT_TRUST_WEIGHT=1
FLAG_HALF_LIFE_DAYS=30

# Find payments by scanning Transfer logs, so both operators see the same evidence
# without waiting for someone to POST a settlement. Turn it on for both operators or for
# neither: one scanning and one not diverges on every agent.
PAYMENT_SCAN_ENABLED=1
PAYMENT_SCAN_FROM_BLOCK=
PAYMENT_SCAN_CHUNK=
PAYMENT_SCAN_CONFIRMATIONS=

# ---- left off at launch --------------------------------------------------------------
# Epoch fees are 0 in the Bootstrap stage. Leave FEE_REGISTRY_ADDRESS unset until fees are
# switched on; a checker must never have it set.
FEE_REGISTRY_ADDRESS=
# The ERC-8004 feed (externalScore) and the ERC-8183 jobs reader are off. Setting
# EXTERNAL_RPC, EXTERNAL_IDENTITY_ADDRESS and EXTERNAL_REPUTATION_ADDRESS turns the first
# on; leave all three unset at launch so externalScore stays 0 on both operators.
EXTERNAL_RPC=
EXTERNAL_IDENTITY_ADDRESS=
EXTERNAL_REPUTATION_ADDRESS=
JOBS_REGISTRY_ADDRESS=

# ---- set by the compose file, not here ----------------------------------------------
# HOST, PORT, ORACLE_STATE_PATH and ORACLE_PRIVATE_KEY_FILE are fixed in
# docker-compose.mainnet.yml and override anything written here.

# --- payer-signed outcomes (docs/adr/0006-payer-signed-outcomes.md) ------------------------
# Off on mainnet until ADR 0006's rollout says otherwise. PUBLISH and PEERS stay off until the
# retention policy covers copies held elsewhere and peer import has had its review (ADR 0006,
# Rollout 5; docs/operations-runbook.md, section 2). The README's configuration table has each
# setting in full.
PAYER_OUTCOMES=off
PAYER_OUTCOMES_PUBLISH=off
PAYER_OUTCOMES_PEERS=
