# Sigvara oracle, CHECKER operator (second bonded operator), Arc mainnet (chain 5042).
#
# Copy to .env beside docker-compose.mainnet.yml on the checker's own host. Fill in every
# line marked FILL. Do NOT copy the primary's .env: it carries settings that make a checker
# refuse to start or, worse, run.
#
# The key is a file secret, secrets/oracle_key, and must be a different key from the
# primary's. Two processes signing with one key share a nonce, and an operator set of two
# addresses that are really one is a set of one.
#
# The checker needs its own bond (SigvaraOracleBond.bondAmount, 2,500,000 SVR on mainnet),
# its own admission by DEFAULT_ADMIN_ROLE, and ORACLE_ROLE on SigvaraReputation. A checker
# that is not an admitted operator starts and logs a warning rather than failing, so
# confirm the admission landed. Steps are in oracle/RUNBOOK-second-operator.md.

# ---- which role, which code (read by docker compose) -------------------------------
COMPOSE_PROFILES=checker
# Full 40-character commit hash. Use the primary's commit unless you are rolling a change
# out one operator at a time: different scoring code shows up as divergence.
SIGVARA_REF=FILL
HOST_PORT=3031

# ---- the four that are not negotiable ------------------------------------------------
ORACLE_MODE=checker
DIVERGENCE_TOLERANCE=3
# Below half the 6 hour challenge window. A longer cadence misses proposals entirely, and
# an empty /divergence would then read as "checked, found nothing".
EPOCH_HOURS=1
# Must stay empty. Startup refuses a checker with a fee registry: chargeEpoch is not
# idempotent, so the agent would pay twice for one epoch.
FEE_REGISTRY_ADDRESS=

# ---- a different chain view from the primary -----------------------------------------
# Measured 21 Oct 2026, mainnet, public endpoints:
#
#   quicknode    getLogs span 9,920; receipts resolve 96 days back or more; refused 16 of
#                60 calls with HTTP 429 when sent at 2 a second. This one, for its
#                receipt depth. A busy epoch over many agents wants a paid plan.
#   blockdaemon  getLogs span 99,840 on a quiet address but 17,760 on busy USDC; receipts
#                resolve only about 1.4 days back, so a checker here refuses settlements
#                the primary accepts.
#   dRPC         getLogs span 100. Unusable for scanning, fine for the watcher.
#
# A provider that agrees about getTotalScore proves nothing: that is an eth_call at head
# and all of them pass it. Test eth_getTransactionReceipt on an old transaction and
# eth_getLogs at the span the scanner asks for (oracle/experiments/measure-rpc.mjs).
RPC_URL=https://rpc.quicknode.mainnet.arc.io

# The chain this checker is for. Nothing is read for scoring or signed while the RPC reports
# another, and a state file saved on another chain is refused. A checker whose provider
# failed over onto the wrong chain would otherwise audit the primary against that chain's
# payments and report a divergence in the primary. Needs the oracle code from the chain
# robustness change; older code ignores it.
EXPECTED_CHAIN_ID=5042

# Same registries as the primary.
IDENTITY_ADDRESS=FILL
REPUTATION_ADDRESS=FILL
FROM_BLOCK=FILL
LOG_CHUNK_SIZE=9000

# Transactions and the clock: the same as the primary's, and for the same reason. The
# checker signs when it covers for a silent primary or finalizes a score it agrees with.
TX_WAIT_SECONDS=60
MAX_FEE_GWEI=1000
MAX_TX_COST=1
MAX_CLOCK_SKEW_SECONDS=600

# ---- scoring inputs: identical to the primary, line for line -------------------------
PAYMENT_VERIFICATION=required
PAYMENT_ASSET=0x3600000000000000000000000000000000000000
PAYMENT_MIN_AMOUNT=10000
PAYMENT_MIN_CONFIRMATIONS=1
PAYMENT_FEE_UNIT=100000000
PAYMENT_HALF_LIFE_DAYS=90
PAYMENT_MAX_PER_PAYER=4
PAYMENT_TRUST_WEIGHT=1
FLAG_HALF_LIFE_DAYS=30
PAYMENT_SCAN_ENABLED=1
PAYMENT_SCAN_FROM_BLOCK=
PAYMENT_SCAN_CHUNK=
PAYMENT_SCAN_CONFIRMATIONS=
EXTERNAL_RPC=
EXTERNAL_IDENTITY_ADDRESS=
EXTERNAL_REPUTATION_ADDRESS=
JOBS_REGISTRY_ADDRESS=

# ---- the primary, for divergence records ---------------------------------------------
# Named in each divergence so a reader knows where the other side's evidence lives.
PRIMARY_EVIDENCE_URL=FILL

# ---- HTTP ------------------------------------------------------------------------------
# Required, because the container binds 0.0.0.0. The checker accepts attestations from
# nobody, so this guards endpoints no one is expected to call, but the startup guard counts
# credentials, not intentions. Generate with: openssl rand -hex 32
ORACLE_ADMIN_TOKEN=FILL

# The network the host's reverse proxy reaches this container from. A published port arrives
# from the compose network's gateway, so list that network's subnet. Without it every visitor,
# the watcher included, is keyed on one address and shares one rate-limit bucket:
#   docker network inspect sigvara-mainnet_default --format '{{(index .IPAM.Config 0).Subnet}}'
# Needs the oracle code from the HTTP hardening change.
TRUSTED_PROXIES=FILL

# ---- set by the compose file, not here ----------------------------------------------
# HOST, PORT, ORACLE_STATE_PATH and ORACLE_PRIVATE_KEY_FILE are fixed in
# docker-compose.mainnet.yml and override anything written here.
