# Divergence watcher. Copy to .env on the watcher box and fill in CHECKER_URL.
#
# This file holds no key and no token. The watcher signs nothing and can touch nothing;
# it reads the checker, re-verifies each disagreement against the chain, and shouts.

# --- the checker to watch --------------------------------------------------------
# Must be a checker. A primary returns 404 on /divergence, and the watcher treats that
# as a misconfiguration rather than as good news.
#
# The checker publishes to 127.0.0.1 on its own box, so this cannot be a loopback
# address unless you have given up on running the watcher on a third host. Point it at a
# read-only surface exposing /health and /divergence and nothing else: the checker's
# write endpoints are token-gated, but an endpoint that cannot be reached needs no token.
CHECKER_URL=

# --- a chain view independent of BOTH the oracle and the checker -----------------
# The primary uses Circle, the checker uses QuickNode. If the watcher shares a provider
# with the checker, the pair can agree about a chain neither is seeing correctly.
#
# dRPC is right for this job and wrong for the others: it rejects eth_getLogs ranges of
# a thousand blocks, which makes it useless for an oracle, but the watcher only ever
# makes two eth_calls (getPendingScore, challengeWindow) and never scans logs.
RPC_URL=https://rpc.drpc.testnet.arc.io

REPUTATION_ADDRESS=0x6603C96275e85F724Cdf74666b399365e4cA29ed

# --- timing ----------------------------------------------------------------------
# The challenge window is 6 hours. Poll often enough to leave the committee usable time
# inside it: at 300s a divergence is seen within five minutes of the checker recording it.
POLL_SECONDS=300

# Silence from the checker for longer than this is itself an alert. A checker that stops
# answering is not a checker that found nothing.
MAX_SILENCE_MINUTES=120

# Second, louder alert when a challenge window is this close to closing.
FINAL_WARNING_MINUTES=60

# --- where alerts go --------------------------------------------------------------
# Treat an empty WEBHOOK_URL as an incomplete deployment, not an optional extra. Without
# it every alert goes to the container log only, on a host nobody is watching, which is
# the hour this component exists for.
#
# The payload is shaped from the URL's hostname, so paste the webhook you were given and
# nothing else needs setting:
#   Discord    https://discord.com/api/webhooks/<id>/<token>       -> {content}
#   Slack      https://hooks.slack.com/services/<T>/<B>/<X>        -> {text}
#   Telegram   https://api.telegram.org/bot<TOKEN>/sendMessage     -> {chat_id, text}
#   anything else                                                  -> {level,title,lines,at,checker}
WEBHOOK_URL=

# Telegram only, ignored elsewhere. Every other destination identifies its target in the
# URL. For a channel this is the numeric -100... id, not the @name.
WEBHOOK_CHAT_ID=
