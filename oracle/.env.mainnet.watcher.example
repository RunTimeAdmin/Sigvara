# Sigvara divergence watcher, Arc mainnet (chain 5042).
#
# Copy to .env beside docker-compose.mainnet.yml on a THIRD host: not the primary, and not
# the checker. A watcher sharing a machine with what it watches goes down with it, and its
# silence then reads as "nothing to report".
#
# This file holds no key and no token. The watcher signs nothing and can touch nothing; it
# reads the checker, re-verifies each disagreement against the chain, and posts to a webhook.

# ---- which role, which code (read by docker compose) -------------------------------
COMPOSE_PROFILES=watcher
SIGVARA_REF=FILL

# ---- the checker to watch -------------------------------------------------------------
# Must be a checker; a primary answers 404 on /divergence and the watcher reports that as
# a misconfiguration. The checker publishes to loopback on its own box, so point this at
# a read-only surface that exposes /health, /divergence and /evidence/ and nothing else
# (oracle/nginx-checker.conf.example).
CHECKER_URL=FILL

# ---- a chain view independent of both operators ---------------------------------------
# The primary uses Circle's endpoint and the checker uses QuickNode's. dRPC is right for
# this job and wrong for the others: it answers getLogs spans of about 100, but the watcher
# only ever makes two eth_calls (getPendingScore, challengeWindow) and never scans logs.
RPC_URL=https://rpc.drpc.mainnet.arc.io
REPUTATION_ADDRESS=FILL

# ---- timing ----------------------------------------------------------------------------
# The challenge window is 6 hours. Poll often enough to leave the committee usable time
# inside it. The watcher refuses an interval under 30 seconds.
POLL_SECONDS=300
# Silence from the checker for longer than this is itself an alert: a checker that stops
# answering is not a checker that found nothing.
MAX_SILENCE_MINUTES=120
# A second, louder alert when a challenge window is this close to closing.
FINAL_WARNING_MINUTES=60

# ---- where alerts go -------------------------------------------------------------------
# An empty WEBHOOK_URL is an incomplete deployment, not an optional extra: without it every
# alert goes to the container log on a host nobody is watching, which is the hour this
# component exists for. The payload is shaped from the URL's hostname:
#   Discord    https://discord.com/api/webhooks/<id>/<token>
#   Slack      https://hooks.slack.com/services/<T>/<B>/<X>
#   Telegram   https://api.telegram.org/bot<TOKEN>/sendMessage
WEBHOOK_URL=FILL
# Telegram only. For a channel this is the numeric -100... id, not the @name.
WEBHOOK_CHAT_ID=
