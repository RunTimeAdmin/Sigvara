# Public read-only surface for a checking operator.
#
# The watcher has to run on a third host, so it cannot reach the checker's loopback
# publish. This exposes exactly the two endpoints it needs and 404s everything else.
#
# Do not reverse_proxy the whole service. The checker's write endpoints (/attest, /flag,
# /link, /epoch) are token-gated, but a path that cannot be reached needs no token, and
# the token is one leaked env file away from being the only thing in the way. The same
# reasoning produced Caddyfile.oracle.example for the primary.
#
# /divergence being public is deliberate rather than tolerated. The protocol already
# publishes evidence roots so anyone can recompute a score; publishing whether two
# independent operators agree on it is the same argument one step further. It carries no
# secret: every field in it is derived from on-chain state plus payments the evidence
# endpoint already exposes.
#
# Mount at /etc/caddy/Caddyfile. Validate before reloading, because a bad config on
# reload takes down every site this Caddy serves:
#   docker exec sigvara-caddy caddy validate --config /etc/caddy/Caddyfile

checker.sigvara.xyz {
	encode gzip

	# Exactly what the watcher polls, and nothing else.
	#   /health      — liveness, and the field the watcher uses to tell
	#                  "checker is up and found nothing" from "checker is gone"
	#   /divergence  — the collection, plus /divergence/<didHash> for one agent
	@readonly path /health /divergence /divergence/*
	handle @readonly {
		reverse_proxy sigvara-checker:3030
	}

	# Everything else, including every write path, never reaches the service.
	handle {
		respond "not found" 404
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
