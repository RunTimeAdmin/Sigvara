# Slash keeper (keeper.js, docs/operations-runbook.md section 7).
# Copy to /docker/sigvara-keeper/.env on each keeper's host, mode 0600: in live mode it holds a key.

# The commit to run: the full hash of a commit on main that someone has read.
SIGVARA_COMMIT=

# shadow (the default) reads everything and logs each call it would make, and sends nothing.
# live calls executeSlash.
KEEPER_MODE=shadow

# Which one this is, for its log and alerts.
KEEPER_NAME=primary

# How long past a slash's deadline to wait before acting. 0 on the primary. On the backup, long
# enough for the primary to have gone first, so only one pays the gas: 3600 is an hour.
KEEPER_GRACE_SECONDS=0

# Agents to leave alone, as comma-separated didHashes, or none. Live mode will not start without
# this being set. Agent C of the adversarial slash drill stays here until it is expired after
# 24 November 2026 03:45 UTC (docs/slash-drill.md): a keeper without it would burn its 750 SVR and
# spoil day 21 of the drill.
KEEPER_SKIP_AGENTS=0x30b95fc4473e5ea0f187d4955ab24bcfebd7a739a0a93c1beafd5d6445f1d93a

# Arc testnet. Give the two keepers different endpoints if you can.
RPC_URL=https://rpc.testnet.arc.network
STAKING_ADDRESS=0xA69d62B2a6774D21A2c15d5d83b27277eD31d35B

# Where the scan for filed slashes starts. A slash older than three weeks is past both its windows,
# so a recent block will do. 70400000 is before the adversarial slash drill filed.
KEEPER_FROM_BLOCK=70400000
LOG_CHUNK_SIZE=10000
KEEPER_POLL_SECONDS=300

# Live mode only. This key holds no role, and executeSlash is open to anyone, so all it can lose is
# its gas. Give each keeper its own, and keep only a few USDC on it.
#   docker run --rm node:24-alpine node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# Set it here first and start in shadow mode: the log names the address to fund.
KEEPER_PRIVATE_KEY=
# What it will pay, and an alert when its balance falls below this. In USDC, Arc's gas token. An
# execution used 153,258 gas on a fork of Arc on 4 November 2026, about 0.0025 USDC, so 0.2 is many.
KEEPER_MAX_FEE_GWEI=200
KEEPER_MAX_GAS=1000000
KEEPER_MIN_BALANCE=0.2

# Where alerts go: a Discord or Telegram webhook, as the watcher uses. Blank logs them only.
WEBHOOK_URL=
WEBHOOK_CHAT_ID=
