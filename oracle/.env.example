# Sigvara oracle.
#
# Arc testnet (5042002) is the current target — see docs/arc.md.
#   RPC_URL=https://rpc.testnet.arc.io
#   gas is USDC (18 decimals on-chain); fund the oracle wallet at https://faucet.circle.com
#   addresses come from deployments/5042002.json after you run Deploy.s.sol

RPC_URL=https://rpc.testnet.arc.io

# Oracle wallet private key — must have ORACLE_ROLE on SigvaraReputation
# Generate a fresh wallet: cast wallet new
ORACLE_PRIVATE_KEY=0x...

# Contract addresses — fill from deployments/<chainId>.json
IDENTITY_ADDRESS=0x...
REPUTATION_ADDRESS=0x...

# Epoch interval. Set to 1 for testnet fast feedback, 24 for production cadence.
EPOCH_HOURS=1

# HTTP bind address — defaults to 127.0.0.1 (localhost only) for bare-metal runs.
# In Docker set HOST=0.0.0.0: docker-compose.oracle.yml publishes the port as
# 127.0.0.1:3030 (that mapping is what restricts access to the host), and the app
# must bind 0.0.0.0 INSIDE the container or the published port can't reach it.
# Only expose beyond localhost with ORACLE_ADMIN_TOKEN set.
HOST=127.0.0.1

# HTTP port
PORT=3030

# Block to start scanning AgentRegistered events from: the deploy block minus a small
# buffer (cast block-number --rpc-url arc_testnet around deploy time).
FROM_BLOCK=0

# Max blocks per eth_getLogs call.
LOG_CHUNK_SIZE=2000

# Bearer token protecting /attest, /flag, /link, and /epoch from public writes.
# If unset, those endpoints are open (fine for local testing, not for a public VPS —
# the server logs a warning at startup). Generate with: openssl rand -hex 32
ORACLE_ADMIN_TOKEN=

# Per-service write credentials. Each ORACLE_TOKEN_<NAME> is an independent token, and
# <NAME> is what the oracle logs when that caller writes.
#
#   ORACLE_TOKEN_COUNTERAUDIT=...
#   ORACLE_TOKEN_HOODSCAN=...
#
# One shared token is fine while the operator is the only writer, and stops being a
# secret the moment a second service holds it: revoking one integration then means
# rotating every integration, so in practice nobody revokes anything, and the write log
# cannot say which service acted. Give each integration its own.
#
# To revoke one, delete or empty its line and restart. The startup banner lists the
# credential names it loaded (never the values), which is where you confirm it went.
# ORACLE_ADMIN_TOKEN still works, as the credential named `admin`.
#
# Generate each with: openssl rand -hex 32

# Path to the JSON state file (attestations, flags, links, cooldowns).
# Must be writable; parent directories are created automatically.
# In Docker, mount a volume to this directory for persistence across restarts.
ORACLE_STATE_PATH=/data/oracle-state.json
#
# The state file also holds the AgentRegistered log scan cursor, so a restart
# resumes rather than replaying the chain from FROM_BLOCK. Delete the file and the
# next start rescans from FROM_BLOCK, which is the recovery path if the cursor is
# ever wrong, but on a busy chain that scan can be large enough for a public RPC
# to rate limit it.

# Minimum milliseconds before the same attester can re-attest the same agent.
# Prevents attestation spam and score inflation. Default: 3600000 (1 hour).
# Set to 0 to disable cooldowns (not recommended for production).
ATTEST_COOLDOWN_MS=3600000

# ---- Payment-backed attestations -------------------------------------------
# With verification off, /attest is an unauthenticated POST carrying whatever
# `attester` string the caller chose, and feeScore is attestation count divided
# by ten. That makes the largest factor in the score a count of HTTP requests.
#
# Set to "required" and an attestation must reference the settlement transaction
# of a real payment to the agent's own address: the `transaction` field of an
# x402 X-PAYMENT-RESPONSE, or any other transfer that settled on chain. The
# oracle reads the receipt, takes the payer from the transfer itself, credits the
# settlement once, and computes feeScore from measured volume.
#
# Default "off" so existing testnet deployments keep working. Mainnet should be
# "required": scores mean very little without it.
PAYMENT_VERIFICATION=off

# The ERC-20 payments settle in. Required when verification is on.
# Arc USDC facade: 0x3600000000000000000000000000000000000000
PAYMENT_ASSET=

# Smallest payment that counts, in the asset's own base units (USDC has 6
# decimals, so 10000 is one cent). Stops dust from minting attestations.
PAYMENT_MIN_AMOUNT=0

# Confirmations before a settlement is accepted. Raise it on a chain where
# reorgs are a real risk.
PAYMENT_MIN_CONFIRMATIONS=1

# Base units of volume per point of feeScore, capped at 30 points.
# 100000000 with 6-decimal USDC is one point per $100, so the cap lands at $3,000
# of settled volume. That matches the figure in docs/reputation-model.md.
PAYMENT_FEE_UNIT=100000000

# Days after which a payment counts half. Without decay, volume accumulates
# forever: an agent that did $3,000 of business last year still scores full marks
# today having done nothing since, and a one-off burst of farmed volume is
# permanent. Decay makes the score track current behaviour and makes farming an
# ongoing cost. Applies to successScore too, so a stale run of successes stops
# masking recent failures. Set 0 to disable.
PAYMENT_HALF_LIFE_DAYS=90

# Half-life for community flags, in days. Flags were the one signal that never
# decayed: one raised a year ago cost the same two points as one raised this
# morning. The argument for decaying evidence runs in reverse for a penalty — an
# agent that has behaved for months should stop paying for a single old flag, and a
# watchdog feed that misfires should not mark someone permanently. Shorter than the
# payment half-life by default because a flag is an accusation nobody has had to
# substantiate. Set 0 to disable decay and restore the old permanent behaviour.
FLAG_HALF_LIFE_DAYS=30

# How much evidence one counterparty can contribute: at most this many points of
# feeScore, and this many attestations of weight. Without a cap, one wallet paying
# ten times counts exactly as much as ten wallets paying once, so a small ring of
# addresses is worth as much as a real customer base. At the default of 5,
# reaching the 30-point cap needs at least six distinct payers. Set 0 to disable.
#
# Payments from the agent's own operator or agent address are always refused,
# whatever this is set to.
PAYMENT_MAX_PER_PAYER=5

# Web of trust. A counterparty that is itself a scored Sigvara agent is better
# evidence than an anonymous wallet, so its cap above is raised in proportion to
# its own score: at 1.0 a perfectly scored counterparty counts double. It also
# feeds propagationScore, one point per fully trusted counterparty up to five.
#
# Counterparty scores are the matured ones, which lag what has just been earned,
# so a reciprocal pair cannot lift each other in a single epoch. A ring of fresh
# agents all score 0 and grant each other nothing, which is the property that
# makes this worth having: a web of trust that bootstrapped from nothing would be
# worse than none. Set 0 to weight every payer alike.
PAYMENT_TRUST_WEIGHT=1

# Optional: SigvaraEpochFees registry address. When set AND its on-chain
# epochFee > 0, the oracle only scores agents with fee coverage and charges one
# epoch fee per agent it scores (tokenomics §4). Leave unset to score every agent
# (testnet default). The oracle wallet must hold ORACLE_ROLE on the registry.
FEE_REGISTRY_ADDRESS=

# Optional: ERC-8004 registries for the externalScore factor (max 15). When all
# three are set, an agent LINKED to an ERC-8004 identity it owns (POST /link)
# gets an external-trust score computed from its 8004 feedback (see external.js).
# Unset leaves externalScore at 0. Canonical testnet singletons on Base Sepolia:
EXTERNAL_RPC=https://sepolia.base.org
EXTERNAL_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
EXTERNAL_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# ---------------------------------------------------------------------------
# Second operator: checker mode
# ---------------------------------------------------------------------------
# Set ORACLE_MODE=checker to run this process as a SECOND bonded operator that
# audits the primary rather than racing it. Leave unset (or 'primary') for the
# operator that actually proposes scores.
#
# Why the distinction exists. SigvaraReputation stores ONE pending proposal per
# agent: a second proposeReputation overwrites the first and restarts its
# challenge window, and finalizeReputation only asks that the window elapsed
# unchallenged. There is no quorum, no median, no vote. So two operators both
# proposing would not produce agreement, they would produce a race, and the
# loser's opinion would be silently discarded.
#
# A checker therefore never competes for the slot:
#   nothing pending              -> proposes (covers for a silent primary)
#   pending, agrees, window open -> does nothing
#   pending, agrees, window past -> finalizes
#   pending, disagrees           -> records a divergence and touches NOTHING
#
# That last prohibition is the point. Overwriting a disputed proposal restarts
# the challenge window and buys it another six hours beyond the reach of
# SLASHING_COMMITTEE_ROLE, which holds the only power to reject it. The
# committee has always had that power and has never had anything telling it
# when to use it; divergences are that signal, readable at GET /divergence.
#
# Run it on different hardware and a different RPC endpoint from the primary.
# A checker sharing a host and a chain view with what it checks mostly proves
# that the code is deterministic.
#
# It needs its own wallet, its own 1000 SVR bond, its own admission by
# DEFAULT_ADMIN_ROLE on SigvaraOracleBond, and its own state file.
#
# A checker must run with FEE_REGISTRY_ADDRESS UNSET: chargeEpoch is not idempotent, so
# a second operator running the fee path would charge the agent twice for one epoch.
# Startup refuses the combination. And EPOCH_HOURS must be below half the challenge
# window (under 3 on Arc testnet), or proposals expire before the checker ever sees them.
ORACLE_MODE=
# Total score points of disagreement tolerated before it is called a divergence.
# Two honest operators scanning at different moments differ by a point or two: a
# payment lands between their scans, or an age bucket ticks over. Alerting on
# that would train the committee to ignore alerts. Applied to the total AND to
# any single factor, so offsetting errors cannot cancel into apparent agreement.
#
# Validated at startup and capped at 10. Number('3 points') is NaN, every comparison
# against NaN is false, and the comparisons here are all '>' — so an unvalidated
# tolerance would not make the checker noisy, it would make it agree with every proposal
# on chain. A large finite value does the same and looks more plausible in a config file.
DIVERGENCE_TOLERANCE=3
