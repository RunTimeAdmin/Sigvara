# Checker-mode operator. Copy to .env on the checker box and fill in the two blanks.
#
# Do NOT copy the primary's .env. It carries the primary's key and its fee registry,
# and a checker running the fee path would debit agents a second time for one epoch.

# --- the four that are not negotiable -------------------------------------------
# Startup refuses to run if the first two are wrong, but do not rely on that to catch
# a typo you could avoid. Reasons in RUNBOOK-second-operator.md step 6.
ORACLE_MODE=checker
DIVERGENCE_TOLERANCE=3
EPOCH_HOURS=1
FEE_REGISTRY_ADDRESS=

# --- a different chain view from the primary ------------------------------------
# The primary uses Circle (rpc.testnet.arc.io). A checker sharing its provider mostly
# proves the code is deterministic. Arc testnet has four independent endpoints; all
# four were live and agreed on getTotalScore when last checked, 20 Sep 2026.
#   https://rpc.blockdaemon.testnet.arc.io
#   https://rpc.drpc.testnet.arc.io
#   https://rpc.quicknode.testnet.arc.io
RPC_URL=https://rpc.blockdaemon.testnet.arc.io

# --- contracts, Arc testnet 5042002 ---------------------------------------------
IDENTITY_ADDRESS=0x7e3aFC532eE5d922ab3cc3FFb510c7C8151477Dd
REPUTATION_ADDRESS=0x6603C96275e85F724Cdf74666b399365e4cA29ed

# --- scoring inputs: must match the primary exactly ------------------------------
# These are not preferences. The checker exists to recompute the same score from the
# same rules; a different half-life or fee unit guarantees divergence on every agent
# and tells you nothing about whether the primary is honest.
PAYMENT_VERIFICATION=required
PAYMENT_ASSET=0x41De2D6D55318e197a00E8f5B496eA2790e23E6c
PAYMENT_MIN_AMOUNT=1000000000000000000
PAYMENT_MIN_CONFIRMATIONS=1
PAYMENT_FEE_UNIT=100000000000000000000
PAYMENT_HALF_LIFE_DAYS=90
PAYMENT_MAX_PER_PAYER=5
PAYMENT_TRUST_WEIGHT=1
FROM_BLOCK=62662100
LOG_CHUNK_SIZE=10000

# --- its own state, never the primary's -----------------------------------------
ORACLE_STATE_PATH=/data/oracle-state.json
PORT=3030

# 0.0.0.0 is required, not a preference: the container publishes to the host as
# 127.0.0.1:3031:3030, and Docker cannot forward to a process bound to the container's
# own loopback. Binding 127.0.0.1 here would make the port mapping silently dead.
#
# That makes ORACLE_ADMIN_TOKEN below REQUIRED. Startup refuses a non-loopback HOST with
# no write credentials at all, rather than exposing /flag, /link and /epoch unauthenticated.
HOST=0.0.0.0

# --- fill these in ---------------------------------------------------------------
# A distinct key. Two processes signing with one key share a nonce and serialise
# against each other, and an operator set whose two members are one address is a set
# of one wearing two hats. Generate on the checker box: cast wallet new
ORACLE_PRIVATE_KEY=

# REQUIRED, because HOST is 0.0.0.0 above. Generate one:  openssl rand -hex 32
#
# The checker does not need to accept attestations from anyone, so this token guards
# endpoints nobody is expected to call. It still has to exist: the startup guard counts
# credentials, not intentions, and an empty value here crash-loops the container with
# "refusing to expose unauthenticated write endpoints".
ORACLE_ADMIN_TOKEN=
