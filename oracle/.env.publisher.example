# ERC-8004 publisher (publisher.js, docs/adr/0008-sigvara-as-erc8004-signal-provider.md).
# Copy to /docker/sigvara-publisher/.env on the primary's host. None of this is secret: the
# publisher holds no key, in either mode.

# The commit to run: the full hash of a commit on main that someone has read.
SIGVARA_COMMIT=

# shadow (the default) reads everything, then logs and records each post it would make, and
# sends nothing. live posts, through the remote signer below, once every gate passes: Sigvara's
# registration's agentWallet is PUBLISHER_ADDRESS, the signer signs as it, and it holds at least
# PUBLISH_MIN_BALANCE. Change to live only after one successful end-to-end cycle (ADR 0008,
# Rollout), and keep PUBLISH_ALLOW_AGENT_IDS on that cycle's one agent until it has passed.
PUBLISH_MODE=shadow

# Arc testnet. The ERC-8004 registries must be on the same chain.
RPC_URL=https://rpc.testnet.arc.network
IDENTITY_ADDRESS=0x7e3aFC532eE5d922ab3cc3FFb510c7C8151477Dd
REPUTATION_ADDRESS=0x6603C96275e85F724Cdf74666b399365e4cA29ed
EXTERNAL_IDENTITY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
EXTERNAL_REPUTATION_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# The same block as both oracle operators, so the publisher finds the links they find.
EXTERNAL_LINK_FROM_BLOCK=70565000
# Where the scan for finalized scores starts. A recent block: every agent scored since is read
# again once a day anyway.
PUBLISH_FROM_BLOCK=
# Sigvara's own ERC-8004 registration (agent 897764 on Arc testnet), which the publisher never
# rates and whose agentWallet names it.
SIGVARA_ERC8004_AGENT_ID=897764

LOG_CHUNK_SIZE=10000
POLL_SECONDS=300

# The publisher's address: the remote signer's key, set as the registration's agentWallet with
# setAgentWallet. Shadow mode runs without it.
PUBLISHER_ADDRESS=

# Live mode only. A JSON-RPC signer (eth_accounts, eth_signTransaction) on another host, backed
# by a KMS or HSM, reachable from this host and nowhere else.
PUBLISH_SIGNER_URL=
# Caps: the most it pays per unit of gas, the most gas one transaction may use, the least it
# must hold before each transaction, and the most transactions (revokes and posts) in one run.
PUBLISH_MAX_FEE_GWEI=
PUBLISH_MAX_GAS=400000
PUBLISH_MIN_BALANCE=0.5
PUBLISH_MAX_TXS_PER_RUN=20
# Comma-separated ERC-8004 agent ids. When set, only these are posted to: the first live cycle.
PUBLISH_ALLOW_AGENT_IDS=
