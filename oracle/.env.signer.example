# The ERC-8004 publisher's policy signer (signer.js). Copy to /docker/sigvara-signer/.env on a
# host that is not the publisher's. The keystore, its password and the HMAC secret go in
# /docker/sigvara-signer/secrets (keystore.json, password, hmac-secret), readable by root alone;
# none of them belongs in this file.

# The commit to run: the full hash of a commit on main that someone has read.
SIGVARA_COMMIT=

# Where it listens, and the only addresses it answers: the publisher's host.
SIGNER_HOST=0.0.0.0
SIGNER_PORT=28600
SIGNER_ALLOW_FROM=72.62.41.138

# A read-only RPC, for the publisher's next nonce and the chain's clock: it signs only that nonce,
# and only an agentWallet message due within five minutes of that clock.
SIGNER_RPC_URL=https://rpc.testnet.arc.network

# What it signs for: Arc testnet, the ERC-8004 registries, Sigvara's registration (agent 897764)
# and that registration's owner (the deployer), the only owner it signs an agentWallet message for.
SIGNER_CHAIN_ID=5042002
SIGNER_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
SIGNER_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
SIGNER_AGENT_ID=897764
SIGNER_AGENT_OWNER=0x18CBcE50390f5f6ebe4E20Fc17833F25c8D94811

# Caps on every transaction it signs, and on how many it signs an hour.
SIGNER_MAX_FEE_GWEI=100
SIGNER_MAX_GAS=400000
SIGNER_MAX_PER_HOUR=60
