# Public read surface for the oracle.
#
# The oracle's port is published on host loopback and the VPS firewall drops 3030, so
# nothing outside the box can reach it. That is correct for the write endpoints and
# wrong for the read ones:
# /evidence exists so a third party can re-derive a score's inputs without trusting us,
# and evidence nobody can fetch is evidence nobody can audit.
#
# This exposes the read paths plus POST /attest. /flag, /flag/resolve, /link and /epoch
# stay on loopback, reachable from the box alone.
#
# /attest is published but not thereby opened: the oracle decides per request. A
# positive attestation carrying a payment it verifies against the chain needs no token,
# because the payment is the credential and the payer is read from the transfer log
# rather than asserted. A negative one still needs the token, because successScore is
# successful/(total+prior) so a negative lowers the score directly, while the payment
# proves only that money moved and never that the work failed. Leaving that open on a
# testnet whose bond token comes from a free faucet would let anyone downgrade any
# agent for the price of a faucet call.
#
# Caddy runs as a container here (countersig-caddy), sharing a host with other sites,
# so this is appended to that stack's Caddyfile rather than installed as its own file.
# Append, never overwrite: the same Caddy serves counteraudit.io, and a reload with a
# truncated config takes every site on the box down, not just this one.
#
#   docker exec countersig-caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec countersig-caddy caddy reload   --config /etc/caddy/Caddyfile
#
# Prerequisites, both of which are easy to miss:
#
#   DNS: oracle.sigvara.xyz must already resolve to this host, or the certificate
#   request fails and the site never comes up.
#
#   Network: Caddy and the oracle must share a Docker network. See the upstream
#   comment below for why the obvious address does not work.

oracle.sigvara.xyz {
	encode gzip

	# Read-only surface, listed explicitly. A path not named here is not proxied, so a
	# future endpoint is private until someone deliberately adds it — the safe default
	# when the same server also holds the signing key.
	@public {
		path /health
		path /score/*
		path /evidence/*
	}

	# /attest is published too, but only POST. Publishing the path does not open the
	# endpoint: the oracle decides per request whether a token is required. A positive
	# attestation carrying a payment it verifies against the chain is self-credentialing;
	# a negative one lowers the score directly and still needs the token. See
	# mayAttestUnauthenticated in http-helpers.js.
	@attest {
		path /attest
		method POST OPTIONS
	}

	# The score badge, which is the one endpoint whose whole purpose is to be loaded
	# from pages this operator does not control. It gets its own block rather than
	# joining @public, because @public pins Access-Control-Allow-Origin to this site's
	# own origin and overrides Cache-Control. Both are right for the JSON read paths
	# and wrong for an image meant to be embedded anywhere.
	@badge {
		path /badge/*
	}

	handle @badge {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Vary "Origin"

		# No Cache-Control here on purpose. The oracle sets its own, and it shortens the
		# lifetime when the chain could not be read so a transient failure is not pinned
		# into every CDN for five minutes. Setting one here would replace that with a
		# fixed number that cannot tell the two cases apart.
		#
		# Cross-Origin-Resource-Policy comes from the oracle too, and has to survive:
		# without it a browser enforcing CORP refuses the image and the badge shows as
		# broken on exactly the third-party pages it exists for.
		reverse_proxy sigvara-oracle:3030
	}

	handle @attest {
		header Access-Control-Allow-Origin "https://sigvara.xyz"
		header Access-Control-Allow-Methods "POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		header Vary "Origin"

		# Never cached: this is a write, and a cached 200 would tell a caller their
		# attestation landed when it did not.
		header Cache-Control "no-store"

		reverse_proxy sigvara-oracle:3030
	}

	handle @public {
		# Let a browser on the site read this directly. Only the site's own origin: the
		# data is public, but a wildcard invites other pages to use this host as free
		# RPC amplification, and every /evidence call costs chain reads.
		header Access-Control-Allow-Origin "https://sigvara.xyz"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Vary "Origin"

		# Scores change once per epoch and evidence only when a score is proposed, so a
		# short cache absorbs a burst of readers without serving anything stale enough
		# to mislead. This is a hint to browsers and CDNs, not a control: a script
		# ignores it, which is why the oracle meters these paths itself.
		header Cache-Control "public, max-age=30"

		# By container name, not 127.0.0.1.
		#
		# Caddy runs in a container, so its 127.0.0.1 is its own loopback and reaches
		# nothing. The host's address does not work either: the oracle publishes on
		# 127.0.0.1:3030:3030, which binds host loopback only and is deliberately not
		# on any interface a container can route to. Both containers therefore join a
		# shared Docker network and Caddy resolves the oracle by service name.
		#
		# This is also the safer arrangement. The port stays published on host loopback
		# for admin use, so /flag, /flag/resolve, /link and /epoch remain reachable only
		# from a shell on the box, while Caddy reaches the published paths over the
		# container network.

		# X-Forwarded-For is left to Caddy, which sets it by default; an explicit
		# header_up here only earns a warning that it is redundant.
		#
		# The oracle depends on this header: it rate-limits /score and /evidence per
		# caller, and behind a proxy every request otherwise keys on one address and
		# shares a single bucket, so one abuser would lock out everyone. Caddy appends
		# the real address to whatever the client sent, and the oracle reads the LAST
		# entry for exactly that reason, so a forged header cannot win a fresh bucket.
		#
		# If this proxy is ever replaced, verify that behaviour rather than assuming it:
		# trip the limit, then retry with a forged X-Forwarded-For. A 200 means the
		# limiter is bypassable.
		reverse_proxy sigvara-oracle:3030
	}

	# Everything else is not served here: /metrics, /flag, /flag/resolve, /link and
	# /epoch. A GET to /attest lands here too, because that matcher takes POST only.
	# /metrics is deliberately excluded: it is unauthenticated by design but publishes
	# operational counters (epoch failures, rate-limit hits, RPC errors) that describe
	# the operator rather than the protocol.
	handle {
		respond "Not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/oracle.log
		format json
	}
}
