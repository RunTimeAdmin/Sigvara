# The only place this site's response headers are defined.
#
# There used to be four: this file, _headers (Netlify), vercel.json and
# nginx-security.conf. The site is served by Apache, so three of them did nothing
# except sit in the document root where anyone could read them, and every policy change
# had to be made four times by hand. Adding one source to img-src for the score badge
# meant editing four files, which is the moment it stopped being tidy and started being
# a way to ship a weaker policy than intended.
#
# That failure is not hypothetical. Two untracked copies of this site elsewhere in the
# working tree still carry `script-src 'self' 'unsafe-inline'`, a policy this one
# dropped, and nothing would have caught a deploy from one of those.
#
# The deleted files are in git history if a move to Netlify or Vercel ever needs them.
# Their per-path cache rules were deliberately NOT ported: they were never active here,
# and `/assets/* immutable max-age=31536000` is not a thing to enable untested on a host
# whose CDN was observed serving stale 404s for a file that existed.
#
# scripts/check-headers.mjs fails the build if a second header source reappears.
#
# Apache 2.4. Enable mod_headers before using this file.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://oracle.sigvara.xyz; font-src 'self'; connect-src 'self' https://rpc.testnet.arc.io; upgrade-insecure-requests"
</IfModule>

# Extensionless URLs.
#
# /demo returned 404 while /demo.html served fine, so every link, QR code or slide that
# dropped the extension was dead. Serve the .html when it exists rather than adding
# per-page redirects, and send a 301 the other way so there is one canonical URL per
# page instead of two that both work.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex, once.
  #
  # www.sigvara.xyz is a CNAME onto the same document root, so without this every page
  # exists at two hostnames and nothing says which one is canonical. First, because a
  # host redirect should happen before any path rewriting.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /demo.html -> /demo, once, for anything typed or linked with the extension.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /demo -> demo.html internally. Only when the file is really there, so a genuine
  # typo still 404s instead of silently serving something else.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
